# Anthropic Claude API Key (required for AI Assistant)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: use an Anthropic-compatible gateway / different model
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Admin Password (required for accessing /admin)
# Choose a secure password
ADMIN_PASSWORD=your_secure_password_here

# Supabase (required for data storage)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sewing: confirmed school domain, configurable; empty explicitly disables login.
# Comma-separated exact domains; never put these values in NEXT_PUBLIC_*.
SEWING_SCHOOL_DOMAINS=uwcchina.org
# Optional Resend transactional email provider (no subscription is created by code).
# Required for email OTP; verified sender required. Keys stay server-side.
SEWING_MAIL_API_KEY=
SEWING_MAIL_FROM=
# Both the makers' agreed inbox and Island to Infinity's inbox, comma-separated.
# Notifications stay pending until sent from the dashboard; no personal WeChat bot.
SEWING_NOTIFY_EMAILS=

# Member platform: keep false until both app and database launch gates pass.
MEMBERS_ENABLED=false
# uwcchina.org is the confirmed and exclusively permitted member email domain.
# Supabase Auth uses custom SMTP configured in its dashboard, NOT client-side keys.
# Set the Auth email template to show {{ .Token }} for code-entry sign-in.
# NEXT_PUBLIC_SITE_URL must be the exact HTTPS origin in production (CSRF check).
